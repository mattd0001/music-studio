\" line377=\"            let n3 = notes[idx(pat, trk, i2)]\" line378=\"            let col = 9\" line379=\"            if (hot) {\" line380=\"                col = 5\" line381=\"            }\" line382=\"            if (n3 &gt;= 0) {\" line383=\"                let h2 = 3 + Math.idiv(n3 * 3, 2)\" line384=\"                screen.fillRect(x, 68 - h2, 7, h2, col)\" line385=\"            } else {\" line386=\"                if (!hot) {\" line387=\"                    col = 12\" line388=\"                }\" line389=\"                screen.fillRect(x, 67, 7, 2, col)\" line390=\"            }\" line391=\"            let tick = 12\" line392=\"            if (i2 % 4 == 0) {\" line393=\"                tick = 6\" line394=\"            }\" line395=\"            screen.fillRect(x, 72, 7, 1, tick)\" line396=\"        }\" line397=\"        screen.drawRect(8 + cur * 9 - 1, 11, 9, 59, 1)\" line398=\"        for (let j2 = 0; j2 &lt; 8; j2++) {\" line399=\"            let c2 = 1\" line400=\"            if (j2 == param) {\" line401=\"                c2 = 5\" line402=\"            }\" line403=\"            screen.print(pName[j2] + &quot;:&quot; + valueText(j2), 4 + (j2 % 2) * 80, 76 + Math.idiv(j2, 2) * 9, c2)\" line404=\"        }\" line405=\"        screen.print(&quot;A edit  B nav  A+B more&quot;, 4, 112, 6)\" line406=\"    }\" line407=\"\" line408=\"    // ---------- BLOCKS ----------\" line409=\"    //% block=&quot;open music studio&quot;\" line410=\"    //% weight=100\" line411=\"    export function openStudio() {\" line412=\"        ensureReady()\" line413=\"        if (playing) {\" line414=\"            stopFlag = true\" line415=\"            pauseUntil(() =&gt; !playing)\" line416=\"        }\" line417=\"        game.pushScene()\" line418=\"        scene.setBackgroundColor(15)\" line419=\"        closed = false\" line420=\"        cur = 0\" line421=\"        pat = 0\" line422=\"        trk = 0\" line423=\"        param = 0\" line424=\"        registerControls()\" line425=\"