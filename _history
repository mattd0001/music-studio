 + t * STEPS + i\" line45=\"    }\" line46=\"\" line47=\"    function getParam(p: number): number {\" line48=\"        if (p &lt; 6) {\" line49=\"            return inst[trk * 6 + p]\" line50=\"        }\" line51=\"        return glob[p - 6]\" line52=\"    }\" line53=\"\" line54=\"    function setParam(p: number, v: number) {\" line55=\"        if (p &lt; 6) {\" line56=\"            inst[trk * 6 + p] = v\" line57=\"        } else {\" line58=\"            glob[p - 6] = v\" line59=\"        }\" line60=\"    }\" line61=\"\" line62=\"    function ensureReady() {\" line63=\"        if (ready) {\" line64=\"            return\" line65=\"        }\" line66=\"        ready = true\" line67=\"        for (let i = 0; i &lt; PATTERNS * PER_PAT; i++) {\" line68=\"            notes.push(-1)\" line69=\"        }\" line70=\"        let w = [3, 1, 4]\" line71=\"        for (let t = 0; t &lt; TRACKS; t++) {\" line72=\"            inst.push(w[t])\" line73=\"            inst.push(200)\" line74=\"            inst.push(0)\" line75=\"            inst.push(100)\" line76=\"            inst.push(80)\" line77=\"            inst.push(0)\" line78=\"        }\" line79=\"        glob.push(150)\" line80=\"        glob.push(4)\" line81=\"        let saved = settings.readString(SAVE_KEY)\" line82=\"        if (saved) {\" line83=\"            deserialize(saved)\" line84=\"        }\" line85=\"    }\" line86=\"\" line87=\"    function serialize(): string {\" line88=\"        let s = &quot;&quot;\" line89=\"        for (let j = 0; j &lt; notes.length; j++) {\" line90=\"            if (notes[j] &lt; 0) {\" line91=\"                s += &quot;-&quot;\" line92=\"            } else {\" line93=\"                s += CH.charAt(notes[j])\" line94=\"            }\" line95=\"        }\" line96=\"        s += &quot;;&quot;\" line97=\"        for (let k = 0; k &lt; inst.length; k++) {\" line98=\"            s += &quot;&quot; + inst[k] + &quot;,&quot;\" line99=\"        }\" line100=\"        s += &quot;&quot; + glob[0] + &quot;,&quot; + glob[1]\" line101=\"        return s\" line102=\"    }\" line103=\"\" line104=\"    function deserialize(s: string): boolean {\" line105=\"        let parts = s.split(&quot;;&quot;)\" line106=\"        if (parts.length &lt; 2 || parts[0].length != notes.length) {\" line107=\"            return false\" line108=\"        }\" line109=\"        for (let l = 0; l &lt; notes.length; l++) {\" line110=\"            let c = parts[0].charAt(l)\" line111=\"            if (c == &quot;-&quot;) {\" line112=\"                notes[l] = -1\" line113=\"            } else {\" line114=\"                notes[l] = Math.constrain(CH.indexOf(c), 0, 35)\" line115=\"            }\" line116=\"        }\" line117=\"        let nums = parts[1].split(&quot;,&quot;)\" line118=\"        if (nums.length &gt;= 20) {\" line119=\"            for (let u = 0; u &lt; TRACKS; u++) {\" line120=\"                for (let m = 0; m &lt; 6; m++) {\" line121=\"                    inst[u * 6 + m] = Math.constrain(parseInt(nums[u * 6 + m]), pMin[m], pMax[m])\" line122=\"                }\" line123=\"            }\" line124=\"            glob[0] = Math.constrain(parseInt(nums[18]), pMin[6], pMax[6])\" line125=\"            glob[1] = Math.constrain(parseInt(nums[19]), pMin[7], pMax[7])\" line126=\"        }\" line127=\"        return true\" line128=\"    }\" line129=\"\" line130=\"    // ---------- SOUND ----------\" line131=\"    function playNote(t: number, n: number) {\" line132=\"        let b = t * 6\" line133=\"        let f = (baseFreq[n % 12] * (1 &lt;&lt; Math.idiv(n, 12))) &gt;&gt; octShift[t]\" line134=\"        let f2 = Math.constrain(Math.idiv(f * inst[b + 3], 100), 1, 5000)\" line135=\"        let dur = Math.max(20, Math.idiv(glob[0] * inst[b + 4], 100))\" line136=\"        music.play(music.createSoundEffect(waves[inst[b]], f, f2, inst[b + 1], inst[b + 2], dur, effects[inst[b + 5]], InterpolationCurve.Linear), music.PlaybackMode.InBackground)\" line137=\"    }\" line138=\"\" line139=\"    function startPlayback() {\" line140=\"        if (playing) {\" line141=\"            return\" line142=\"        }\" line143=\"        playing = true\" line144=\"        stopFlag = false\" line145=\"        control.runInParallel(function () {\" line146=\"            let p0 = startPat\" line147=\"            let endPat = Math.max(glob[1], startPat + 1)\" line148=\"            let again = true\" line149=\"            while (again &amp;&amp; !stopFlag) {\" line150=\"                for (let p = p0; p &lt; endPat; p++) {\" line151=\"                    for (let n = 0; n &lt; STEPS; n++) {\" line152=\"                        if (stopFlag) {\" line153=\"                            break\" line154=\"                        }\" line155=\"                        playPat = p\" line156=\"                        playStep = n\" line157=\"                        for (let v = 0; v &lt; TRACKS; v++) {\" line158=\"                            let o = notes[idx(p, v, n)]\" line159=\"                            if (o &gt;= 0) {\" line160=\"                                playNote(v, o)\" line161=\"                            }\" line162=\"                        }\" line163=\"                        pause(glob[0])\" line164=\"                    }\" line165=\"                    if (stopFlag) {\" line166=\"                        break\" line167=\"                    }\" line168=\"                }\" line169=\"                p0 = 0\" line170=\"                endPat = glob[1]\" line171=\"                again = loopPlay\" line172=\"            }\" line173=\"            playStep = -1\" line174=\"            playPat = -1\" line175=\"            playing = false\" line176=\"        })\" line177=\"    }\" line178=\"\" line179=\"    // ---------- EDITOR ----------\" line180=\"    function showStatus(text: string) {\" line181=\"        status = text\" line182=\"        statusUntil = game.runtime() + 800\" line183=\"    }\" line184=\"\" line185=\"    function noteLabel(): string {\" line186=\"        let q = notes[idx(pat, trk, cur)]\" line187=\"        if (q &lt; 0) {\" line188=\"            return &quot;rest&quot;\" line189=\"        }\" line190=\"        return noteNames[q % 12] + (3 + Math.idiv(q, 12) - octShift[trk])\" line191=\"    }\" line192=\"\" line193=\"    function previewNote() {\" line194=\"        let r = notes[idx(pat, trk, cur)]\" line195=\"        if (r &lt; 0) {\" line196=\"            r = 12\" line197=\"        }\" line198=\"        playNote(trk, r)\" line199=\"    }\" line200=\"\" line201=\"    function changeNote(dir: number) {\" line202=\"        let a = idx(pat, trk, cur)\" line203=\"        let d = notes[a]\" line204=\"        if (d &lt; 0) {\" line205=\"            d = 12\" line206=\"        } else {\" line207=\"            d = Math.constrain(d + dir, 0, 35)\" line208=\"        }\" line209=\"        notes[a] = d\" line210=\"        playNote(trk, d)\" line211=\"    }\" line212=\"\" line213=\"    function toggleNote() {\" line214=\"        let e = idx(pat, trk, cur)\" line215=\"        if (notes[e] &lt; 0) {\" line216=\"            notes[e] = 12\" line217=\"            playNote(trk, 12)\" line218=\"        } else {\" line219=\"            notes[e] = -1\" line220=\"        }\" line221=\"    }\" line222=\"\" line223=\"    function changeParam(dir: number) {\" line224=\"        let g = getParam(param) + dir * pStep[param]\" line225=\"        if (param == 0 || param == 5) {\" line226=\"            let span = pMax[param] + 1\" line227=\"            g = (getParam(param) + dir + span) % span\" line228=\"        }\" line229=\"        setParam(param, Math.constrain(g, pMin[param], pMax[param]))\" line230=\"        previewNote()\" line231=\"    }\" line232=\"\" line233=\"    function chord(d: number) {\" line234=\"        if (d == 0) {\" line235=\"            clip = []\" line236=\"            for (let h = 0; h &lt; PER_PAT; h++) {\" line237=\"                clip.push(notes[pat * PER_PAT + h])\" line238=\"            }\" line239=\"            showStatus(&quot;Copied!&quot;)\" line240=\"        } else if (d == 1) {\" line241=\"            if (clip.length == PER_PAT) {\" line242=\"                for (let k2 = 0; k2 &lt; PER_PAT; k2++) {\" line243=\"                    notes[pat * PER_PAT + k2] = clip[k2]\" line244=\"                }\" line245=\"                showStatus(&quot;Pasted!&quot;)\" line246=\"            } else {\" line247=\"                showStatus(&quot;Copy first&quot;)\" line248=\"            }\" line249=\"        } else if (d == 2) {\" line250=\"            for (let k3 = 0; k3 &lt; PER_PAT; k3++) {\" line251=\"                notes[pat * PER_PAT + k3] = -1\" line252=\"            }\" line253=\"            showStatus(&quot;Cleared&quot;)\" line254=\"        } else {\" line255=\"            closed = true\" line256=\"        }\" line257=\"    }\" line258=\"\" line259=\"    function onDir(d: number) {\" line260=\"        let a2 = controller.A.isPressed()\" line261=\"        let b2 = controller.B.isPressed()\" line262=\"        if (a2 &amp;&amp; b2) {\" line263=\"            aUsed = true\" line264=\"            bUsed = true\" line265=\"            chord(d)\" line266=\"        } else if (a2) {\" line267=\"            aUsed = true\" line268=\"            if (d == 0) {\" line269=\"                param = (param + 7) % 8\" line270=\"            } else if (d == 1) {\" line271=\"                param = (param + 1) % 8\" line272=\"            } else if (d == 2) {\" line273=\"                changeParam(-1)\" line274=\"            } else {\" line275=\"                changeParam(1)\" line276=\"            }\" line277=\"        } else if (b2) {\" line278=\"            bUsed = true\" line279=\"            if (d == 0) {\" line280=\"                trk = (trk + 2) % TRACKS\" line281=\"            } else if (d == 1) {\" line282=\"                trk = (trk + 1) % TRACKS\" line283=\"            } else if (d == 2) {\" line284=\"                pat = (pat + 3) % PATTERNS\" line285=\"       